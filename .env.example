MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=root
DB_USERNAME=root
DB_PASSWORD=root

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
REDIS_PORT=6379

IDENTITY_SERVICE_URL=http://localhost:8081
ORGANIZATION_CUSTOMER_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083
RENTAL_SERVICE_URL=http://localhost:8084
AI_SERVICE_URL=http://localhost:8090
FRONTEND_URL=http://localhost:5173
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Dùng cùng issuer/secret cho Identity, Organization-Customer, Inventory và Rental.
JWT_ISSUER=equipment-rental-identity
# Sinh secret Base64 ít nhất 32 byte cho môi trường thật; không commit secret thật.
JWT_SECRET_BASE64=REPLACE_WITH_A_BASE64_SECRET_OF_AT_LEAST_32_BYTES
JWT_ACCESS_TOKEN_MINUTES=30

# Rental đọc DB_URL; các service còn lại đọc MYSQL_HOST/MYSQL_PORT.
DB_URL=jdbc:mysql://localhost:3306/rental_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh

# Điền SMTP hoặc để trống nếu demo không gửi email thật.
MAIL_USERNAME=
MAIL_PASSWORD=
